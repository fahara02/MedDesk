# Use the account with which the band is actually paired.
# amazfit is the bundled extractor's name for the Zepp account route.
ACCOUNT_METHOD=amazfit
EMAIL=your-zepp-account@example.com
ZEPP_PASSWORD=your-zepp-account-password
# For a Xiaomi account instead: ACCOUNT_METHOD=xiaomi and XIAOMI_PASSWORD=...
# Gmail's separate PASSWORD is never used by the band wrapper.
# The band's Bluetooth address, as six hexadecimal pairs separated by colons.
BLUETOOTH_ADDRESS=
# Private 16-byte band key, 32 hex characters (optional 0x prefix).
Key=
